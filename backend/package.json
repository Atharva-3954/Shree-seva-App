{
  "name": "shree-seva-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Shree Seva Shop - Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:test": "tsx src/scripts/testDb.ts"
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "@neondatabase/serverless": "^0.9.5",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "zod": "^3.23.8",
    "cloudinary": "^2.4.0",
    "multer": "^1.4.5-lts.1",
    "cookie-parser": "^1.4.6"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^1.4.12",
    "@types/cookie-parser": "^1.4.7",
    "@types/node": "^22.5.5",
    "tsx": "^4.19.1",
    "esbuild": "^0.24.0",
    "drizzle-kit": "^0.24.2"
  }
}